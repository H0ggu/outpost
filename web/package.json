{
  "name": "@outpost/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outpost web app: React SPA (index.html) and the vendored lila analysis board (studio.html).",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.studio.json && tsc -p tsconfig.node.json && npm run -s typecheck:studio-boundary",
    "typecheck:studio-boundary": "if tsc -p tsconfig.studio.json --listFilesOnly | grep /vendor/lila/ | grep -v /vendor/lila/@types/lichess/; then echo 'error: the files above are vendored lila sources pulled into tsconfig.studio.json. Import them as lila/<package>/<module> and declare what you use in src/studio/lila-types (docs/CONVENTIONS.md, Studio).' >&2; exit 1; fi"
  },
  "dependencies": {
    "@badrap/result": "0.3.1",
    "@lichess-org/chessground": "10.5.0",
    "@lichess-org/pgn-viewer": "2.7.3",
    "@lichess-org/stockfish-web": "0.6.1",
    "@outpost/shared": "*",
    "@tanstack/react-query": "5.108.3",
    "cash-dom": "8.1.5",
    "chessops": "0.15.1",
    "d3-array": "3.2.5",
    "d3-geo": "3.1.2",
    "d3-interpolate": "3.0.2",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "d3-time": "3.1.1",
    "d3-time-format": "4.1.1",
    "debounce-promise": "3.1.2",
    "i18n-iso-countries": "7.14.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "snabbdom": "3.5.1",
    "stockfish.js": "10.0.2",
    "tablesort": "5.7.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-geo": "3.1.1",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/d3-time": "3.0.4",
    "@types/d3-time-format": "4.0.3",
    "@types/debounce-promise": "3.1.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "sass": "1.108.2",
    "vite": "8.3.8"
  }
}
