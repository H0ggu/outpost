# Outpost configuration (docs/PLAN.md §3). Copy to .env and edit.
# Empty values count as unset. `npm run dev`, `npm start` and docker compose all read .env.
# `npm start` and Docker always run in production (PUBLIC_ORIGIN required); `npm run dev` runs in
# development.

# Port to listen on.
PORT=8080

# Address to bind (0.0.0.0 = all interfaces; 127.0.0.1 keeps it local, e.g. behind a reverse proxy
# on the same host). Ignored by docker compose: the container always binds 0.0.0.0 — to keep it
# local there, publish the port on 127.0.0.1 in docker-compose.yml instead.
HOST=0.0.0.0

# The public address users type into the browser — scheme, host and port, no path.
# REQUIRED in production: used for the Origin/CSRF check, the Secure cookie flag (https) and
# absolute links. Examples: https://chess.example.com   http://192.168.1.10:8080
# In development leave it empty to use http://localhost:5173; to open the dev server from another
# device, set it to that address (e.g. http://192.168.1.10:5173).
PUBLIC_ORIGIN=

# Proxies whose X-Forwarded-For you trust, so rate limits see real client IPs. Comma-separated
# IPs, CIDRs, or the named ranges loopback / linklocal / uniquelocal. Leave empty when clients
# connect directly. Example for a proxy on the same host: loopback. `true` / `*` (trust everyone)
# is refused: any client could then fake its IP and dodge the login throttling.
TRUSTED_PROXIES=

# Where the SQLite database, the Stockfish NNUE cache and uploads live. Relative paths resolve
# against the repository root. Docker sets this to /data (mounted from ./data).
DATA_DIR=./data

# Lichess personal API token (any scope; study:read recommended):
#   https://lichess.org/account/oauth/token/create?scopes[]=study:read&description=Outpost
# Required for the Lichess opening explorer, player explorer and broadcasts; also speeds up
# game export and enables rating history. The admin can set it in the UI instead; this wins.
# It never reaches the browser.
LICHESS_TOKEN=

# Contact details for the User-Agent sent to Chess.com and Lichess:
#   Outpost/<version> (self-hosted; contact: <value>)
# Chess.com refuses anonymous user agents. An email address or your Chess.com username.
# The admin can set it in the UI instead; this wins.
CHESSCOM_CONTACT=

# One-time token for creating the first admin at /setup. Leave empty to have one generated and
# printed to the server log on start-up while no admin exists. At least 16 characters if set.
SETUP_TOKEN=

# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Background workers (job queue, auto refresh): on by default, off under NODE_ENV=test.
# OUTPOST_WORKERS=true

# Node environment. `npm start` and Docker force production; `npm run dev` uses development.
# NODE_ENV=production
