{
  "name": "@outpost/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outpost HTTP server: Fastify 5 + node:sqlite, run directly with Node type stripping.",
  "license": "AGPL-3.0-or-later",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=../.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.12",
    "@outpost/shared": "*",
    "chessops": "0.15.1",
    "fastify": "5.12.8",
    "qrcode": "1.5.4",
    "undici": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6"
  }
}
